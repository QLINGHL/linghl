# ============================================================================
# Codex 桌面复刻版 —— Git 忽略规则
#
# 原则：仓库里只放**源码与文档**。凡是「能重新生成」或「体积过大」或
# 「含本机/隐私信息」的，一律不入库。
# ============================================================================

# ── 依赖 ──────────────────────────────────────────────────────────────────
node_modules/

# ── 构建产物（可随时重新生成）─────────────────────────────────────────────
.vite/
out/
dist/
dist-renderer/
dist-py/
.renderer-backup/

# ── 内置内核二进制（**约 430MB**，不入库）─────────────────────────────────
#   vendor/codex/bin/codex.exe 单个就 309MB，**超过 GitHub 单文件 100MB 硬上限**，
#   推上去会被直接拒绝。而且它的版权属于第三方，本来也不该进本仓库。
#   打包前按 README 的说明单独获取（forge.config.js 的 extraResource 会用到）。
vendor/codex/

# ── 运行时 / 诊断产物 ────────────────────────────────────────────────────
artifacts/            # 排查过程中的临时目录（本机曾累积到 8GB+）
.screenshots/         # 验收脚本的截图输出（tools/*.cjs 里的 OUT）
.replica-userdata/    # 数据目录降级时的备用 userData（含 .write-probe-*）
logs/
*.log

# ── 排查过程截图（约 150 张 / 19MB）──────────────────────────────────────
#   根目录那些 verify-*.png / shot-*.png / _zoom-*.png / compare-*.png
#   是当时比对官方界面用的，不是项目资产。
*.png
# 但源码里将来若放进真正要打包的图片资源，必须能提交
!src/**/*.png

# ── 本机环境探测转储（含本机绝对路径）───────────────────────────────────
.env-electron.json
.env-node.json

# ── 本机 playwright 路径覆盖（见 tools/playwright-loader.mjs）─────────────
#   内容是本机 playwright 的绝对路径。留着它，别人 clone 后按 loader 的提示
#   自己装一份即可，仓库里不会出现任何人的本机目录。
tools/.playwright-path.local

# ── 编辑器 / 系统 ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~

# ── 临时文件 ─────────────────────────────────────────────────────────────
*.tmp
*.bak.tmp-*
